<section class="hero">
    <div class="container position-relative" style="z-index: 1;">
        <div class="row align-items-center gy-5">
            <!-- Texto -->
            <div class="col-lg-7 order-2 order-lg-1">
                <div class="hero-badge">
                    <span class="dot"></span>
                    Disponible para nuevos proyectos
                </div>

                <h1>
                    Hola, soy<br>
                    <span class="name-highlight">Alexander Gomez</span>
                </h1>

                <p class="hero-subtitle">
                    Desarrollador Full Stack con más de 12 años de experiencia, especializado en tecnologías
                    <strong style="color: var(--accent);">.NET</strong> y <strong style="color: var(--accent);">JavaScript</strong>.
                    He colaborado con empresas como Orange, Banco BHD y Gold's Gym.
                </p>

                <div class="hero-ctas">
                    <a asp-controller="Home" asp-action="Proyectos" class="btn btn-primary">
                        <i class="bi bi-grid me-2"></i>Ver proyectos
                    </a>
                    <a asp-controller="Home" asp-action="Contacto" class="btn btn-outline-light">
                        <i class="bi bi-envelope me-2"></i>Contáctame
                    </a>
                </div>

                <div class="hero-stats">
                    <div class="hero-stat">
                        <div class="stat-number">12+</div>
                        <div class="stat-label">Años de exp.</div>
                    </div>
                    <div class="hero-stat">
                        <div class="stat-number">20+</div>
                        <div class="stat-label">Proyectos</div>
                    </div>
                    <div class="hero-stat">
                        <div class="stat-number">5+</div>
                        <div class="stat-label">Empresas</div>
                    </div>
                </div>
            </div>

            <!-- Foto -->
            <div class="col-lg-5 order-1 order-lg-2">
                <div class="hero-foto-wrap">
                    <img id="foto" src="~/img/foto.jpg" alt="Foto de Alexander Gomez" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Banner de bienvenida -->
<section class="welcome-banner text-center">
    <div class="container">
        <h2>Bienvenido a mi portafolio</h2>
        <p>
            He desarrollado software profesionalmente desde 2012, trabajando principalmente con C#/ASP.NET,
            SQL Server, Entity Framework y JavaScript. Me apasiona construir soluciones robustas y bien diseñadas.
        </p>
    </div>
</section>
